# PaperInfo Environment Configuration
# Copy this file to .env and fill in your actual API keys

# ============================================
# Flask Configuration
# ============================================
SECRET_KEY=
# PaperInfo defaults to localhost only. Set 0.0.0.0 explicitly for trusted LAN use.
PAPERINFO_HOST=127.0.0.1
PAPERINFO_PORT=5000
FLASK_DEBUG=0

# ============================================
# LLM Provider API Keys
# ============================================
# Choose one or more providers below and add your API keys

# OpenAI (for GPT-4o-mini, GPT-4o, etc.)
# Get your key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Anthropic (for Claude models)
# Get your key from: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Zhipu AI (for GLM models)
# Get your key from: https://open.bigmodel.cn/usercenter/apikeys
ZHIPUAI_API_KEY=

# ============================================
# GLM primary + DeepSeek fallback (OpenAI-compatible APIs)
# ============================================
# Store keys in operating-system environment variables, not in this file:
# PAPERINFO_GLM_API_KEY
# PAPERINFO_DEEPSEEK_API_KEY
CUSTOM_GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
CUSTOM_GLM_MODEL=glm-4-flash
CUSTOM_DEEPSEEK_BASE_URL=https://api.deepseek.com
CUSTOM_DEEPSEEK_MODEL=deepseek-chat
LLM_PRIMARY_FAILURE_COOLDOWN=300

# ============================================
# Translation: Azure -> DeepSeek -> MyMemory
# ============================================
# Store AZURE_TRANSLATE_API_KEY in an operating-system environment variable.
# AZURE_TRANSLATE_REGION is optional for the global Translator resource.
AZURE_TRANSLATE_ENDPOINT=https://api.cognitive.microsofttranslator.com
# AZURE_TRANSLATE_REGION=
TRANSLATION_TIMEOUT=20

# ============================================
# Feishu update notifications (optional)
# ============================================
# Add a custom bot to a Feishu group, then store its Webhook and optional
# signature secret in operating-system environment variables (recommended):
# PAPERINFO_FEISHU_WEBHOOK_URL=
# PAPERINFO_FEISHU_WEBHOOK_SECRET=
FEISHU_NOTIFICATION_TIMEOUT=10
# Optional LAN/public URL reachable from your phone; adds a batch detail link.
# PAPERINFO_PUBLIC_URL=http://192.168.1.100:5000

# Scheduler catch-up protection and per-source request budgets
CATCH_UP_GRACE_MINUTES=30
ARXIV_REQUEST_TIMEOUT=20
ARXIV_MAX_RETRIES=1
DBLP_REQUEST_TIMEOUT=30
DBLP_MAX_RETRIES=1
# 按 venue stream key 下载稳定的索引与年度目录 XML，主站失败后自动切换官方镜像。
DBLP_BASE_URLS=https://dblp.org,https://dblp.uni-trier.de,https://dblp.dagstuhl.de
# venue 索引/当年目录缓存 24 小时，历史目录缓存 1 年；刷新失败时最多使用 30 天旧缓存。
DBLP_CACHE_DIR=data/dblp_cache
DBLP_CACHE_TTL_HOURS=24
DBLP_STALE_CACHE_DAYS=30
# 真实 DBLP API 冒烟测试默认跳过；需要时临时设为 1 后运行测试。
# RUN_DBLP_LIVE_TESTS=1

# Author affiliation enrichment via OpenAlex (free key required since 2026)
# Create a key at https://openalex.org/settings/api and store it in the OS environment:
# PAPERINFO_OPENALEX_API_KEY=
OPENALEX_DELAY=0.5
OPENALEX_REQUEST_TIMEOUT=20
OPENALEX_MAX_RETRIES=2

# Public PDF discovery via Unpaywall. Store the contact email in the OS environment:
# PAPERINFO_UNPAYWALL_EMAIL=you@example.com
UNPAYWALL_DELAY=0.5
UNPAYWALL_REQUEST_TIMEOUT=20
UNPAYWALL_MAX_RETRIES=2

# Optional Crossref polite-pool contact; Unpaywall email is reused when omitted.
# PAPERINFO_CROSSREF_MAILTO=you@example.com
CROSSREF_DELAY=0.25
CROSSREF_REQUEST_TIMEOUT=20
CROSSREF_MAX_RETRIES=2
METADATA_PAGE_DELAY=1.0
METADATA_PDF_PROBE_TIMEOUT=20
# Retry incomplete metadata around day 1, 3, 7 and 30 after insertion.
METADATA_RETRY_HOURS=24,72,168,720
METADATA_RETRY_BATCH_SIZE=100

# Local Zotero desktop integration (no cloud API key required)
ZOTERO_LOCAL_URL=http://127.0.0.1:23119
ZOTERO_LOCAL_TIMEOUT=15
PDF_DOWNLOAD_TIMEOUT=60
PDF_DOWNLOAD_DELAY=1.0
PDF_MAX_MB=50

# Legacy single custom endpoint examples:

# Moonshot (月之暗面) (https://api.moonshot.cn)
# CUSTOM_LLM_API_KEY=
# CUSTOM_LLM_BASE_URL=https://api.moonshot.cn
# CUSTOM_LLM_MODEL=moonshot-v1-8k

# SiliconFlow (硅基流动) (https://api.siliconflow.cn)
# CUSTOM_LLM_API_KEY=
# CUSTOM_LLM_BASE_URL=https://api.siliconflow.cn/v1
# CUSTOM_LLM_MODEL=Qwen/Qwen2.5-72B-Instruct

# OpenRouter (https://openrouter.ai/api)
# CUSTOM_LLM_API_KEY=
# CUSTOM_LLM_BASE_URL=https://openrouter.ai/api/v1
# CUSTOM_LLM_MODEL=meta-llama/llama-3.1-70b-instruct

# Local LLM (e.g., Ollama, LM Studio)
# CUSTOM_LLM_API_KEY=not-needed
# CUSTOM_LLM_BASE_URL=http://localhost:11434/v1
# CUSTOM_LLM_MODEL=llama3.1

# ============================================
# LLM Evaluator Settings
# ============================================
# Provider to use for paper relevance evaluation
# Options: openai, anthropic, zhipu, custom
LLM_PROVIDER=openai

# Score thresholds for saving papers (0-100)
# Papers must meet BOTH thresholds to be saved
LLM_RELEVANCE_THRESHOLD=30  # Relevance/Correlation threshold
LLM_VALUE_THRESHOLD=30       # Value/Merit threshold

# Legacy single threshold (for backward compatibility)
# If set, both thresholds above will use this value
LLM_FILTER_THRESHOLD=30

# Enable/disable LLM filtering
LLM_FILTER_ENABLED=true

# Enable/disable parallel LLM evaluation (recommended for faster processing)
LLM_PARALLEL_ENABLED=true

# Maximum number of concurrent threads for LLM evaluation
# Increase for faster processing, but respect API rate limits
LLM_MAX_WORKERS=5

# Timeout (in seconds) for each LLM evaluation request
LLM_EVALUATION_TIMEOUT=30

# Custom system prompt for LLM evaluation (optional)
# If not set, uses a general academic research prompt
# This prompt is used as the default when a domain doesn't have its own prompt
# LLM_SYSTEM_PROMPT=You are an academic research assistant. Evaluate the relevance of the following paper...
